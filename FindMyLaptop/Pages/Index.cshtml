@page
@model IndexModel
@{
    ViewData["Title"] = "FindMyLaptop - Discover Best Deals Across Retailers";
}

<!-- Lock mobile viewport scale & disable pinch zoom -->
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no" />

<script src="https://cdn.tailwindcss.com"></script>
<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    brand: {
                        50: '#f0f7ff',
                        100: '#e0effe',
                        500: '#2563eb',
                        600: '#1d4ed8',
                        700: '#1e40af',
                        900: '#1e3a8a',
                    },
                    sharaf: '#e11d48',
                    jumbo: '#0284c7',
                    emax: '#d97706',
                    alershad: '#7c3aed',
                },
                fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                }
            }
        }
    }
</script>

<style>
    /* Prevent horizontal page overflow & smooth scrolling */
    html, body {
        overflow-x: hidden;
        touch-action: manipulation;
        -webkit-text-size-adjust: 100%;
    }

    .glass-header {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite ease-in-out;
    }

    @@keyframes skeleton-loading {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<!-- Sticky Glass Header -->
<header class="sticky top-0 z-40 glass-header border-b border-slate-200/80 shadow-sm transition-all duration-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <h1 class="font-bold text-lg sm:text-xl tracking-tight text-slate-900 leading-none">FindMy<span class="text-blue-600">Laptop</span></h1>
                <p class="text-[10px] text-slate-500 font-medium tracking-wide">COMPARE UAE RETAILERS</p>
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <!-- Floating Compare Action Bar Trigger -->
            <button id="compareFloatingBtn" onclick="openCompareModal()" class="hidden items-center space-x-1.5 px-3.5 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs sm:text-sm font-semibold shadow-lg shadow-blue-500/20 transition animate-bounce">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <span>Compare (<span id="compareCountBadge">0</span>/2)</span>
            </button>

            <div id="statsBadge" class="hidden sm:flex items-center space-x-2 text-xs font-medium text-slate-600 bg-slate-100 px-3 py-1.5 rounded-full border border-slate-200">
                <span id="cachedStatusDot" class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
                <span id="statsText">Live Cross-Retailer Search</span>
            </div>
        </div>
    </div>
</header>

<!-- Hero / Filter Section -->
<section class="bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-3xl mx-auto px-4 py-6 sm:py-8 text-center">
        <h2 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Find the Best Laptop Within Your Budget
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-500 max-w-lg mx-auto">
            Compare real-time options across <span class="text-rose-600 font-semibold">SharafDG</span>, <span class="text-sky-600 font-semibold">Jumbo</span>, <span class="text-amber-600 font-semibold">Emax</span>, <span class="text-purple-600 font-semibold">AlErshad</span>, and <span class="text-emerald-600 font-semibold">Carrefour</span> instantly.
        </p>

        <!-- Search & Brand Filter Form -->
        <form id="searchForm" onsubmit="handleSearch(event)" class="mt-6 max-w-lg mx-auto space-y-3">
            <div class="relative flex items-center">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-semibold text-sm">
                    AED
                </div>
                <input type="number"
                       id="maxPriceInput"
                       name="maxPrice"
                       value="@(Model.MaxPrice ?? 4000)"
                       placeholder="Enter Max Price (e.g. 3500)"
                       min="500"
                       max="25000"
                       step="100"
                       required
                       class="block w-full pl-14 pr-28 py-3.5 text-slate-900 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-600 focus:border-blue-600 text-base sm:text-sm font-medium transition shadow-inner appearance-none" />
                <button type="submit"
                        class="absolute right-1.5 top-1.5 bottom-1.5 px-4 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-semibold text-xs sm:text-sm rounded-lg shadow transition-all duration-150 flex items-center space-x-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Filter</span>
                </button>
            </div>

            <!-- Controls Bar: Brand, Sorting, Clear Compare, Reset -->
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 pt-1">
                <div>
                    <select id="brandSelect" onchange="handleSearch()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm font-medium text-slate-700 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition">
                        <option value="">All Brands</option>
                    </select>
                </div>
                <div>
                    <select id="sortSelect" onchange="handleSortChange()" class="w-full py-2.5 px-3 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm font-medium text-slate-700 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition">
                        <option value="retailer">Default (Interleaved)</option>
                        <option value="price_low_high">Price: Low to High</option>
                    </select>
                </div>
                <div>
                    <button type="button" onclick="clearCompareSelection()" class="w-full py-2.5 px-3 bg-amber-50 hover:bg-amber-100 active:scale-95 text-amber-700 font-semibold text-xs sm:text-sm rounded-xl border border-amber-300 transition flex items-center justify-center space-x-1">
                        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        <span>Clear Compare</span>
                    </button>
                </div>
                <div>
                    <button type="button" onclick="resetAllFilters()" class="w-full py-2.5 px-3 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-semibold text-xs sm:text-sm rounded-xl border border-slate-300 transition flex items-center justify-center space-x-1">
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span>Reset</span>
                    </button>
                </div>
            </div>
        </form>

        <!-- Quick Filter Chips -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
            <span class="text-slate-400 font-medium w-full sm:w-auto mb-1 sm:mb-0">Quick Budget:</span>
            <button onclick="setBudget(2500)" class="px-2.5 py-1.5 rounded-md bg-slate-100 active:bg-blue-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 transition border border-slate-200">AED 2,500</button>
            <button onclick="setBudget(3500)" class="px-2.5 py-1.5 rounded-md bg-slate-100 active:bg-blue-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 transition border border-slate-200">AED 3,500</button>
            <button onclick="setBudget(5000)" class="px-2.5 py-1.5 rounded-md bg-slate-100 active:bg-blue-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 transition border border-slate-200">AED 5,000</button>
            <button onclick="setBudget(7500)" class="px-2.5 py-1.5 rounded-md bg-slate-100 active:bg-blue-100 hover:bg-blue-50 hover:text-blue-600 text-slate-600 transition border border-slate-200">AED 7,500</button>
        </div>
    </div>
</section>

<!-- Main Content Area -->
<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- Active Filter Indicator -->
    <div id="filterSummaryBar" class="hidden mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between bg-white p-4 rounded-xl border border-slate-200 shadow-sm gap-2">
        <div>
            <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Active Filter</span>
            <p id="summaryText" class="text-sm font-semibold text-slate-800"></p>
        </div>
        <div class="flex items-center space-x-2">
            <span id="cacheBadge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                Cached in Session
            </span>
            <button onclick="clearCacheAndReload()" class="text-xs text-slate-500 hover:text-rose-600 underline font-medium">
                Reset Cache
            </button>
        </div>
    </div>

    <!-- Product Grid Container -->
    <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6"></div>

    <!-- Infinite Scroll Target Observer Trigger -->
    <div id="infiniteScrollTrigger" class="py-8 flex flex-col items-center justify-center space-y-2">
        <div id="scrollSpinner" class="hidden">
            <div class="w-8 h-8 border-3 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
        </div>
        <p id="scrollMessage" class="text-xs text-slate-400 font-medium text-center"></p>
    </div>
</main>

<!-- Compare Modal -->
<div id="compareModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden p-2 sm:p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full overflow-hidden border border-slate-200 transform transition-all my-auto">
        <div class="px-4 sm:px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-base sm:text-lg text-slate-900">Compare Laptops</h3>
                    <p class="text-[10px] sm:text-xs text-slate-500 font-medium">Winner based on Higher RAM & Lower Price</p>
                </div>
            </div>
            <button onclick="closeCompareModal()" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-200/60 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- 2 Products Side-by-Side Flex Layout optimized for Mobile & Desktop -->
        <div id="compareModalContent" class="p-2 sm:p-6 max-h-[80vh] overflow-y-auto flex flex-row gap-2 sm:gap-4 items-stretch">
            <!-- Comparison Side-by-Side Cards Rendered Here -->
        </div>

        <div class="px-4 sm:px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-between items-center">
            <button onclick="clearCompareSelection()" class="px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold text-xs sm:text-sm rounded-xl transition border border-rose-200">
                Clear Selection
            </button>
            <button onclick="closeCompareModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold text-xs sm:text-sm rounded-xl transition">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    let rawInitialData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products));
    let allFilteredProducts = [];
    let currentPage = 1;
    let selectedForCompare = [];

    function getPageSize() {
        return window.innerWidth < 640 ? 4 : 8;
    }

    let pageSize = getPageSize();
    let isLoading = false;
    let observer = null;
    let currentMaxPrice = parseFloat(document.getElementById('maxPriceInput').value) || 4000;

    window.addEventListener('resize', () => {
        pageSize = getPageSize();
    });

    const RETAILERS = {
        'SharafDG': {
            name: 'SharafDG',
            badgeClass: 'bg-rose-600 text-white',
            borderHover: 'hover:border-rose-300',
            btnColor: 'bg-rose-50 text-rose-700 hover:bg-rose-100'
        },
        'Jumbo': {
            name: 'Jumbo',
            badgeClass: 'bg-sky-600 text-white',
            borderHover: 'hover:border-sky-300',
            btnColor: 'bg-sky-50 text-sky-700 hover:bg-sky-100'
        },
        'Emax': {
            name: 'Emax',
            badgeClass: 'bg-amber-600 text-white',
            borderHover: 'hover:border-amber-300',
            btnColor: 'bg-amber-50 text-amber-700 hover:bg-amber-100'
        },
        'AlErshad': {
            name: 'AlErshad',
            badgeClass: 'bg-purple-600 text-white',
            borderHover: 'hover:border-purple-300',
            btnColor: 'bg-purple-50 text-purple-700 hover:bg-purple-100'
        },
        'Carrefour': {
                name: 'Carrefour',
            badgeClass: 'bg-emerald-600 text-white',
            borderHover: 'hover:border-emerald-300',
            btnColor: 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100'
        }
    };

    function getProductPrice(product) {
        if (!product) return 0;
        const val = product.price !== undefined ? product.price : product.Price;
        return parseFloat(val) || 0;
        }

        function getProductBrand(product) {
        if (!product) return '';
        return (product.brand || product.Brand || '').toString().trim();
        }

       function getProductRetailer(product) {
        if (!product) return '';
        return (product.Retailer || product.retailer || '').toString().trim();
        }

      function getProductRamValue(product) {
        if (!product) return 0;
        const name = (product.Name || product.name || '').toString();
            const ramMatch = name.match(/(\d+)\s*(?:GB|gb)\b(?:\s*RAM)?/i);
        if (ramMatch && ramMatch[1]) {
            return parseInt(ramMatch[1], 10) || 0;
        }
        return 0;
        }

       function getProductRamText(product) {
        const val = getProductRamValue(product);
        return val > 0 ? `${val} GB` : 'Standard';
        }

       function getProductId(product) {
        if (!product) return '';
            return product.Url || product.url || product.Name || product.name || JSON.stringify(product);
        }

       function updateBrandDropdown(products) {
        const brandSelect = document.getElementById('brandSelect');
         const currentSelectedBrand = brandSelect.value;

            const brands = [...new Set(products.map(p => getProductBrand(p)).filter(b => b.length > 0))].sort();

          brandSelect.innerHTML = '<option value="">All Brands</option>';
           brands.forEach(brand => {
            const opt = document.createElement('option');
            opt.value = brand;
            opt.textContent = brand;
                if (brand === currentSelectedBrand) {
                opt.selected = true;
            }
                brandSelect.appendChild(opt);
        });
        }

         function sortProductsWithInterleavedRetailers(products) {
        if (!products || !Array.isArray(products)) return [];

          const retailerBuckets = {};

        products.forEach(p => {
                const retailer = getProductRetailer(p) || 'Other';
            if (!retailerBuckets[retailer]) {
                retailerBuckets[retailer] = [];
            }
                retailerBuckets[retailer].push(p);
        });

            for (const key in retailerBuckets) {
            retailerBuckets[key].sort((a, b) => getProductPrice(b) - getProductPrice(a));
            }

        const pools = {};
            const remaining = {};

        for (const key in retailerBuckets) {
            pools[key] = retailerBuckets[key].slice(0, 200);
                remaining[key] = retailerBuckets[key].slice(200);
        }

         const interleavedList = [];
            let itemAddedInRound = true;
         let roundIndex = 0;

          while (itemAddedInRound && roundIndex < 200) {
            itemAddedInRound = false;
            for (const key in pools) {
                if (pools[key].length > roundIndex) {
                        interleavedList.push(pools[key][roundIndex]);
                    itemAddedInRound = true;
                }
            }
            roundIndex++;
            }

        const allRemaining = [];
            for (const key in remaining) {
            allRemaining.push(...remaining[key]);
        }

        return [...interleavedList, ...allRemaining];
        }

    function filterAndSortProducts(products, maxPrice) {
           if (!products || !Array.isArray(products)) return [];

            const selectedBrand = document.getElementById('brandSelect').value;
          const sortMode = document.getElementById('sortSelect').value;

          const filtered = products.filter(p => {
              const price = getProductPrice(p);
              if (price <= 0 || price > maxPrice) return false;

            if (sortMode === 'price_low_high') {
                    const retailer = getProductRetailer(p);
                if (retailer.toLowerCase() === 'alershad' && price < 1000) {
                    return false;
                }
            }

            if (selectedBrand) {
                const brand = getProductBrand(p);
                    if (brand.toLowerCase() !== selectedBrand.toLowerCase()) return false;
            }

            return true;
            });

        if (sortMode === 'price_low_high') {
                return filtered.sort((a, b) => getProductPrice(a) - getProductPrice(b));
        } else {
            return sortProductsWithInterleavedRetailers(filtered);
        }
        }

        function handleSortChange() {
        const priceInput = document.getElementById('maxPriceInput');
           const maxPrice = parseFloat(priceInput.value) || 4000;
        const cacheKey = `findmylaptop_results_${maxPrice}`;
            const cachedData = sessionStorage.getItem(cacheKey);

          if (cachedData) {
            const rawParsed = JSON.parse(cachedData);
            resetGrid();
            allFilteredProducts = filterAndSortProducts(rawParsed, maxPrice);
            updateSummaryBar(maxPrice, true);
                renderNextPage();
        } else {
            handleSearch();
            }
        }

        async function handleSearch(event) {
        if (event) event.preventDefault();

        const priceInput = document.getElementById('maxPriceInput');
        const maxPrice = parseFloat(priceInput.value);

            if (!maxPrice || maxPrice <= 0) return;

        currentMaxPrice = maxPrice;
            const cacheKey = `findmylaptop_results_${maxPrice}`;
        const cachedData = sessionStorage.getItem(cacheKey);

             resetGrid();
              showSkeletons();

         if (cachedData) {
                setTimeout(() => {
                const rawParsed = JSON.parse(cachedData);
                updateBrandDropdown(rawParsed);
                allFilteredProducts = filterAndSortProducts(rawParsed, maxPrice);
                    updateSummaryBar(maxPrice, true);
                renderNextPage();
             }, 250);

        } else {
          updateSummaryBar(maxPrice, false);

             try {
                const response = await fetch(`?handler=Search&maxPrice=${maxPrice}`);
                    if (!response.ok) throw new Error("Server response failed");

                const rawProducts = await response.json();
                updateBrandDropdown(rawProducts);
                allFilteredProducts = filterAndSortProducts(rawProducts, maxPrice);

                sessionStorage.setItem(cacheKey, JSON.stringify(rawProducts));
                renderNextPage();
                } catch (err) {
                console.error("Error fetching laptops from server:", err);
            }
        }
    }

    function setBudget(amount) {
        document.getElementById('maxPriceInput').value = amount;
        handleSearch();
        }

    function resetAllFilters() {
            document.getElementById('maxPriceInput').value = 4000;
        document.getElementById('brandSelect').value = "";
        document.getElementById('sortSelect').value = "retailer";
        handleSearch();
        }

    function clearCompareSelection() {
            selectedForCompare = [];
        updateCompareUI();
        refreshCardSelectionStates();
        closeCompareModal();
        }

       function resetGrid() {
        currentPage = 1;
        pageSize = getPageSize();
            allFilteredProducts = [];
        document.getElementById('productGrid').innerHTML = '';
        document.getElementById('scrollMessage').textContent = '';
        if (observer) observer.disconnect();
        }

       function showSkeletons() {
          const grid = document.getElementById('productGrid');
          grid.innerHTML = '';
            const skeletonCount = window.innerWidth < 640 ? 4 : 8;
            for (let i = 0; i < skeletonCount; i++) {
                const skel = document.createElement('div');
                skel.className = 'bg-white rounded-xl p-4 border border-slate-200 shadow-sm space-y-3';
                skel.innerHTML = `
                    <div class="h-4 skeleton rounded w-1/3"></div>
                    <div class="h-44 sm:h-36 skeleton rounded-lg"></div>
                    <div class="h-4 skeleton rounded w-3/4"></div>
                    <div class="h-3 skeleton rounded w-1/2"></div>
                <div class="pt-2 flex justify-between items-center">
                    <div class="h-5 skeleton rounded w-1/3"></div>
                    <div class="h-8 skeleton rounded-lg w-1/4"></div>
                    </div>
            `;
            grid.appendChild(skel);
        }
        }

        function updateSummaryBar(price, isCached) {
        const bar = document.getElementById('filterSummaryBar');
        const summaryText = document.getElementById('summaryText');
        const cacheBadge = document.getElementById('cacheBadge');
          const selectedBrand = document.getElementById('brandSelect').value;

        bar.classList.remove('hidden');
            let text = `Laptops under AED ${price.toLocaleString()}`;
        if (selectedBrand) {
            text += ` • Brand: ${selectedBrand}`;
            }
        summaryText.textContent = text;

        if (isCached) {
            cacheBadge.classList.remove('hidden');
                cacheBadge.textContent = 'Loaded from Session Storage';
        } else {
            cacheBadge.classList.add('hidden');
        }
        }

     function renderNextPage() {
            const grid = document.getElementById('productGrid');
        const spinner = document.getElementById('scrollSpinner');
        const message = document.getElementById('scrollMessage');

            if (currentPage === 1) grid.innerHTML = '';

            if (!allFilteredProducts || allFilteredProducts.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center">
                        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-3 text-slate-400">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="text-base font-bold text-slate-800">No Laptops Found</h3>
                    <p class="text-xs text-slate-500 mt-1">Try increasing your budget limit or changing filters above.</p>
                </div>
                `;
            spinner.classList.add('hidden');
            message.textContent = '';
            return;
            }

            const startIndex = (currentPage - 1) * pageSize;
          const endIndex = startIndex + pageSize;
          const pageItems = allFilteredProducts.slice(startIndex, endIndex);

            if (pageItems.length === 0 && currentPage > 1) {
            spinner.classList.add('hidden');
            message.textContent = `Showing all ${allFilteredProducts.length} matching laptops.`;
            return;
            }

            pageItems.forEach((product, idx) => {
            const globalIndex = startIndex + idx;
            const card = createProductCard(product, globalIndex);
                grid.appendChild(card);
        });

            isLoading = false;
        spinner.classList.add('hidden');

         if (endIndex >= allFilteredProducts.length) {
            message.textContent = `Showing all ${allFilteredProducts.length} matching laptops.`;
            if (observer) observer.disconnect();
            } else {
            message.textContent = 'Scroll for more options...';
            setupIntersectionObserver();
        }
        }

        function createProductCard(product, globalIndex) {
        const title = product.Name || product.name || 'Laptop';
        const rawPrice = getProductPrice(product);
        const price = rawPrice.toLocaleString();
        const brand = getProductBrand(product) || 'Brand';
        const ram = getProductRamText(product);
            const retailer = product.Retailer || product.retailer || 'Store';
        const url = product.Url || product.url || '#';
           const isSharafDG = retailer.toString().trim().toLowerCase().includes('sharaf');
         const sharafDgDummyUrl = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTv9xvEsNe-LtVTOl6Yvcf_yNshKUEDaZ9kYgAoK5jtVw&s';
            const imageUrl = isSharafDG ? sharafDgDummyUrl : (product.ImageUrl || product.imageUrl || 'https://via.placeholder.com/300');

            const retailerConfig = RETAILERS[retailer] || {
            badgeClass: 'bg-slate-600 text-white',
            borderHover: 'hover:border-slate-300',
                btnColor: 'bg-slate-50 text-slate-700 hover:bg-slate-100'
        };

        const pId = getProductId(product);
            const isSelected = selectedForCompare.some(p => getProductId(p) === pId);

            const card = document.createElement('div');
            card.className = `bg-white rounded-2xl p-4 border border-slate-200 ${retailerConfig.borderHover} shadow-sm hover:shadow-md transition-all flex flex-col justify-between group`;
            card.innerHTML = `
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${retailerConfig.badgeClass}">${retailer}</span>
                        <span class="text-xs font-semibold text-slate-400">${brand}</span>
                    </div>
                    <div class="h-40 sm:h-36 bg-slate-50 rounded-xl p-3 mb-3 flex items-center justify-center overflow-hidden group-hover:bg-blue-50/30 transition">
                        <img src="${imageUrl}" alt="${title}" class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300" referrerpolicy="no-referrer" />
                    </div>
                    <h3 class="font-bold text-slate-800 text-xs sm:text-sm line-clamp-2" title="${title}">${title}</h3>
                    <div class="mt-2 flex items-center space-x-2">
                        <span class="text-[10px] font-semibold bg-slate-100 text-slate-600 px-2 py-0.5 rounded">RAM: ${ram}</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                    <div>
                        <span class="text-[10px] text-slate-400 block font-medium">Best Price</span>
                        <span class="text-sm sm:text-base font-extrabold text-slate-900">AED ${price}</span>
                    </div>
                    <div class="flex space-x-1.5">
                        <button id="compare_btn_${globalIndex}" onclick="toggleCompare(${globalIndex})" class="py-2 px-3 rounded-lg text-xs font-semibold ${isSelected ? 'bg-emerald-600 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'} transition flex items-center justify-center shadow-sm">
                            <span>${isSelected ? 'Selected ✓' : 'Compare (+)'}</span>
                        </button>
                        <a href="${url}" target="_blank" rel="noopener noreferrer" class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow transition flex items-center space-x-1">
                        <span>Store</span>
                    </a>
                    </div>
            </div>
        `;
            return card;
        }

      function setupIntersectionObserver() {
           if (observer) observer.disconnect();

              const trigger = document.getElementById('infiniteScrollTrigger');
           observer = new IntersectionObserver((entries) => {
                 if (entries[0].isIntersecting && !isLoading) {
                isLoading = true;
                document.getElementById('scrollSpinner').classList.remove('hidden');
                setTimeout(() => {
                        currentPage++;
                    renderNextPage();
                }, 300);
                }
        }, { rootMargin: '200px' });

        observer.observe(trigger);
        }

      function toggleCompare(globalIndex) {
            const product = allFilteredProducts[globalIndex];
        if (!product) return;

        const pId = getProductId(product);
         const existingIndex = selectedForCompare.findIndex(p => getProductId(p) === pId);

          if (existingIndex > -1) {
            selectedForCompare.splice(existingIndex, 1);
        } else {
                if (selectedForCompare.length >= 2) {
                selectedForCompare.pop();
            }
                selectedForCompare.push(product);
        }

        updateCompareUI();
        refreshCardSelectionStates();

        if (selectedForCompare.length === 2) {
            openCompareModal();
        }
        }

       function updateCompareUI() {
        const btn = document.getElementById('compareFloatingBtn');
           const badge = document.getElementById('compareCountBadge');
        badge.textContent = selectedForCompare.length;

         if (selectedForCompare.length > 0) {
            btn.classList.remove('hidden');
            btn.classList.add('flex');
            } else {
            btn.classList.add('hidden');
            btn.classList.remove('flex');
            }
        }

               function refreshCardSelectionStates() {
        allFilteredProducts.forEach((product, idx) => {
                   const btn = document.getElementById(`compare_btn_${idx}`);
                if (btn) {
                const pId = getProductId(product);
                 const isSelected = selectedForCompare.some(p => getProductId(p) === pId);
                  if (isSelected) {
                    btn.className = 'py-2 px-3 rounded-lg text-xs font-semibold bg-emerald-600 text-white transition flex items-center justify-center shadow-sm';
                    btn.querySelector('span').textContent = 'Selected ✓';
                } else {
                    btn.className = 'py-2 px-3 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center justify-center shadow-sm';
                        btn.querySelector('span').textContent = 'Compare (+)';
                }
            }
            });
        }

        function openCompareModal() {
        if (selectedForCompare.length === 0) return;

            const container = document.getElementById('compareModalContent');
        container.innerHTML = '';

            let p1 = selectedForCompare[0];
        let p2 = selectedForCompare[1] || null;

            let p1Price = getProductPrice(p1);
        let p2Price = p2 ? getProductPrice(p2) : null;

            let p1Ram = getProductRamValue(p1);
        let p2Ram = p2 ? getProductRamValue(p2) : null;

        let p1Wins = false;
        let p2Wins = false;

             if (p2) {
            if (p1Ram > p2Ram) p1Wins = true;
            else if (p2Ram > p1Ram) p2Wins = true;
                else {
                if (p1Price < p2Price) p1Wins = true;
                else if (p2Price < p1Price) p2Wins = true;
            }
        }

        container.appendChild(createCompareColumn(p1, p1Wins, p2 ? p2Wins : false));
        if (p2) {
                container.appendChild(createCompareColumn(p2, p2Wins, p1Wins));
        }

        document.getElementById('compareModal').classList.remove('hidden');
        }

       function createCompareColumn(product, isWinner, isLoser) {
        const title = product.Name || product.name || 'Laptop';
        const rawPrice = getProductPrice(product);
        const price = rawPrice.toLocaleString();
        const brand = getProductBrand(product) || 'Brand';
        const ram = getProductRamText(product);
            const retailer = product.Retailer || product.retailer || 'Store';
        const url = product.Url || product.url || '#';
        const isSharafDG = retailer.toString().trim().toLowerCase().includes('sharaf');
            const sharafDgDummyUrl = 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTv9xvEsNe-LtVTOl6Yvcf_yNshKUEDaZ9kYgAoK5jtVw&s';
        const imageUrl = isSharafDG ? sharafDgDummyUrl : (product.ImageUrl || product.imageUrl || 'https://via.placeholder.com/300');

           const col = document.createElement('div');
        col.className = `flex-1 w-1/2 bg-white rounded-xl p-2 sm:p-4 border ${isWinner ? 'border-emerald-500 ring-2 ring-emerald-500/20 bg-emerald-50/10' : 'border-slate-200'} shadow-sm flex flex-col justify-between relative`;

        let badgeHtml = '';
            if (isWinner) {
                badgeHtml = `<div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-emerald-600 text-white text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded-full shadow whitespace-nowrap">Best Value 🏆</div>`;
            }

            col.innerHTML = `
                ${badgeHtml}
                <div>
                    <div class="flex items-center justify-between mb-1.5 sm:mb-2">
                        <span class="text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-1.5 sm:px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">${retailer}</span>
                        <span class="text-[10px] sm:text-xs font-semibold text-slate-400">${brand}</span>
                    </div>
                    <div class="h-24 sm:h-32 bg-slate-50 rounded-xl p-2 mb-2 sm:mb-3 flex items-center justify-center overflow-hidden">
                        <img src="${imageUrl}" alt="${title}" class="max-h-full max-w-full object-contain" referrerpolicy="no-referrer" />
                    </div>
                    <h4 class="font-bold text-slate-800 text-[11px] sm:text-sm line-clamp-2 leading-tight">${title}</h4>
                    <div class="mt-2 sm:mt-3 space-y-1 border-t border-slate-100 pt-2">
                        <div class="flex justify-between text-[11px] sm:text-xs">
                            <span class="text-slate-500">Price:</span>
                            <span class="font-extrabold text-slate-900">AED ${price}</span>
                        </div>
                        <div class="flex justify-between text-[11px] sm:text-xs">
                            <span class="text-slate-500">RAM:</span>
                            <span class="font-semibold text-slate-700">${ram}</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 sm:mt-4 pt-2 sm:pt-3 border-t border-slate-100">
                <a href="${url}" target="_blank" rel="noopener noreferrer" class="block w-full py-1.5 sm:py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[11px] sm:text-xs font-semibold text-center shadow transition">
                    View Store
                    </a>
            </div>
        `;
        return col;
        }

      function closeCompareModal() {
        document.getElementById('compareModal').classList.add('hidden');
    }

    function clearCacheAndReload() {
        sessionStorage.clear();
        handleSearch();
        }

          // Initialize on page load
       document.addEventListener('DOMContentLoaded', () => {
        if (rawInitialData && rawInitialData.length > 0) {
            updateBrandDropdown(rawInitialData);
            allFilteredProducts = filterAndSortProducts(rawInitialData, currentMaxPrice);
            updateSummaryBar(currentMaxPrice, false);
                renderNextPage();
            } else {
                handleSearch();
            }
        });
</script>